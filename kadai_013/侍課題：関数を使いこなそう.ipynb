      "source": [
        "# 消費税を加えた金額を計算する関数\n",
        "def calc_tax(praice: float,tax_) -> float:\n",
        "  # 消費税額を計算\n",
        "  tax_amount = praice * (tax_ / 100)\n",
        "  # 消費税込みの金額を返す\n",
        "  return praice + tax_amount\n",
        "\n",
        "# 実行例\n",
        "result = calc_tax(1000,10)\n",
        "print(result)"
      ]
