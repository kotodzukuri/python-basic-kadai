    {
      "cell_type": "code",
      "source": [
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "i = 0\n",
        "count = 0\n",
        "while count < 2:\n",
        "   while i < len(array):\n",
        "      print(array[i])\n",
        "      i += 1\n",
        "   count += 1\n",
        "   i = 0\n"
