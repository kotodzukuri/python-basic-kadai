      "source": [
        "# 台形の辺の長さ（単位：cm）\n",
        "top = 10\n",
        "bottom = 20\n",
        "height = 5\n",
        "\n",
        "# 面積の計算\n",
        "area = (top + bottom) * height / 2\n",
        "\n",
        "# 出力（単位 cm² をつける）\n",
        "print(f\"{area}cm²\")\n"
      ]
